config_version=5

[application]
config/name="Last Light"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/This Side Up"
config/icon="res://assets/room/dock_icon.png"
run/max_fps=120
run/main_scene="res://game/last_light.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1360
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=752
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025,0.042,0.062,1)

[physics]
common/physics_ticks_per_second=60

[last_light]
radio/url=""
